{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": false,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "paths": {
            "@prisma/client": ["./node_modules/.prisma/client/index.d.ts"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
