// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model IndexerState {
  id         Int      @id @default(1)
  lastPolled DateTime @default(now())
}

model Vault {
  address   String   @id
  markets   Market[]
  createdAt DateTime @default(now())
  }

model Market {
  id       String  @id
  vault    String
  ym       String
  pt       String
  yt       String
  pool     String
  maturity BigInt
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vaultRef Vault @relation(fields: [vault], references: [address])
}
